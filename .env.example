# -----------------------------------------------------------------------------
# Client-safe (exposed to the browser via NEXT_PUBLIC_*)
# These identify the Supabase project. They are not secret, but they are not
# a substitute for Row Level Security.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Server-only secrets — never prefix with NEXT_PUBLIC_
# Never import these into Client Components.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Phase 3: AI Configuration (Server-only)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Phase 6: Email & Notifications Configuration (Server-only)
RESEND_API_KEY=
EMAIL_FROM=Aether Estates <concierge@aetherestates.com>
APP_URL=http://localhost:3000

# Phase 6B: Reminder Automation Cron Secret (Server-only)
CRON_SECRET=

# Phase 6C: WhatsApp Automation Configuration (Server-only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
